{
    "manifest_version": 3,
    "name": "DuckDuckGo Content Blocker Extension",
    "version": "2026.10.22",
    "minimum_chrome_version": "122.0",
    "browser_specific_settings": {
        "duckduckgo": {
            "id": "com.duckduckgo.content-blocker-extension",
            "appleRequiresExtraction": true
        }
    },
    "permissions": ["scripting", "declarativeNetRequest"],
    "host_permissions": [
        "https://*.youtube.com/",
        "https://youtube.com/",
        "https://youtube-nocookie.com/*",
        "https://www.youtube-nocookie.com/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "youtube",
                "enabled": true,
                "path": "rules/youtube.json"
            }
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://tv.youtube.com/*",
                "https://m.youtube.com/*",
                "https://music.youtube.com/*"
            ],
            "js": ["scriptlets/main/ublock-filters.js"],
            "all_frames": false,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://tv.youtube.com/*",
                "https://m.youtube.com/*",
                "https://music.youtube.com/*"
            ],
            "js": ["scriptlets/isolated/ublock-filters.js"],
            "all_frames": false,
            "run_at": "document_start",
            "world": "ISOLATED"
        },
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://tv.youtube.com/*",
                "https://m.youtube.com/*",
                "https://music.youtube.com/*"
            ],
            "js": ["scriptlets/main/ublock-experimental.js"],
            "all_frames": false,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://tv.youtube.com/*",
                "https://m.youtube.com/*",
                "https://music.youtube.com/*"
            ],
            "js": ["scriptlets/isolated/ublock-experimental.js"],
            "all_frames": false,
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ]
}
